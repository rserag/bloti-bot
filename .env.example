# Placeholders only. Never put production values in this file.
API_ID=<telegram-api-id>
API_HASH=<telegram-api-hash>
BOT_TOKEN=<telegram-bot-token>

# Prefer *_FILE variables in production so secrets are mounted as files.
# API_ID_FILE=/run/secrets/api_id
# API_HASH_FILE=/run/secrets/api_hash
# BOT_TOKEN_FILE=/run/secrets/bot_token

SESSION_PATH=./data/blotibot
SOURCE_URL=https://github.com/rserag/bloti-bot
APP_VERSION=dev
MAX_ACTIVE_CHATS=4
MESSAGE_DELAY_SECONDS=1
